# Browser key for the Google base map. Needs "Maps JavaScript API" enabled on the
# key's project and an HTTP-referrer restriction. Without it (or if Google rejects
# it) the app shows an OpenStreetMap base map instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Where the FastAPI service runs (dev proxy target for /api/*).
API_URL=http://127.0.0.1:8000
