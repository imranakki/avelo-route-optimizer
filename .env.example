# Copy to .env to override defaults. Every Settings field in src/avelo/config.py is
# configurable as AVELO_<FIELD>.

# Self-hosted routers (see scripts/prepare_osrm.sh and docker-compose.yml).
# Without these the app uses the public FOSSGIS instances, which are fine for a
# demo and not for bulk work.
AVELO_OSRM_ROOT=http://127.0.0.1:5001
AVELO_OSRM_WALK_ROOT=http://127.0.0.1:5002
AVELO_OSRM_TABLE_MAX_COORDS=1000
AVELO_OSRM_REQUEST_DELAY_SECONDS=0

# Ride plan: 30 or 45 minutes.
AVELO_RIDE_LIMIT_MINUTES=30
